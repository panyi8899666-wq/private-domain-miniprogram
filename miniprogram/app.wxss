/* ==================================================================
   正鑫越文化工作室 小程序 — 全局样式（design §2.4）
   深色工业风设计令牌 + 发光公共 class（纯 CSS，零图片）
   ================================================================== */

/* ---------- 设计令牌（design §2.4.1） ---------- */
page {
  --bg-base: #0b0f14;
  --bg-surface: #121822;
  --bg-surface-2: #1a2332;
  --border-line: #243045;
  --text-primary: #e8eef6;
  --text-secondary: #9dabc0;
  --text-muted: #5c6b7e;
  --accent-glow: #3ec6ff;
  --accent-orange: #ff7a32;
  --success: #3ddc97;
  --warning: #ffc24b;
  --danger: #ff5c5c;

  /* 圆角与阴影（design §2.4.2） */
  --radius-card: 28rpx;
  --radius-btn: 20rpx;
  --radius-tag: 12rpx;
  --shadow-card: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);

  /* 间距刻度 */
  --gap-xs: 8rpx;
  --gap-sm: 16rpx;
  --gap-md: 24rpx;
  --gap-lg: 32rpx;
  --gap-xl: 48rpx;

  background-color: var(--bg-base);
  color: var(--text-primary);
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, button, input, textarea, image, navigator, form {
  box-sizing: border-box;
}

/* 覆盖 button 默认样式，统一由 glow-button / 自定义类控制 */
button::after {
  border: none;
}

/* ==================================================================
   排版
   ================================================================== */
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

.text-body {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.text-aux {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.text-tag {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.text-muted {
  font-size: 24rpx;
  color: var(--text-muted);
}

.text-price {
  color: var(--accent-orange);
  font-weight: 700;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ==================================================================
   布局工具类
   ================================================================== */
.page-container {
  min-height: 100vh;
  padding: 0 var(--gap-lg);
  box-sizing: border-box;
}

.page-header {
  padding: var(--gap-lg) 0 var(--gap-md);
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.section {
  margin-bottom: var(--gap-xl);
}

.divider {
  height: 1rpx;
  background-color: var(--border-line);
  margin: var(--gap-md) 0;
}

/* ==================================================================
   发光公共 class（design §2.4.3，纯 CSS 实现）
   ================================================================== */

/* 渐变发光标题（首页 Hero 大标题） */
.text-glow-gradient {
  background-image: linear-gradient(120deg, #ffffff 0%, var(--accent-glow) 45%, #7b6cff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 0 24rpx rgba(62, 198, 255, 0.25);
}

/* 霓虹光晕文字 */
.text-neon {
  color: #dff3ff;
  text-shadow: 0 0 12rpx rgba(62, 198, 255, 0.6), 0 0 32rpx rgba(62, 198, 255, 0.35);
}

/* 盒体辉光描边（选中态） */
.box-glow {
  border: 1rpx solid rgba(62, 198, 255, 0.55);
  box-shadow: 0 0 18rpx rgba(62, 198, 255, 0.4), 0 0 42rpx rgba(62, 198, 255, 0.18);
}

/* 橙色发光主按钮 */
.btn-primary-glow {
  border: 1rpx solid rgba(255, 122, 50, 0.55);
  background-image: linear-gradient(135deg, #ff8a4a 0%, var(--accent-orange) 100%);
  color: #14100a;
  font-weight: 700;
  box-shadow: 0 0 18rpx rgba(255, 122, 50, 0.45), 0 0 40rpx rgba(255, 122, 50, 0.2);
}

/* 蓝色描边次按钮 */
.btn-secondary-glow {
  border: 1rpx solid rgba(62, 198, 255, 0.5);
  color: var(--accent-glow);
  background-color: rgba(62, 198, 255, 0.08);
}

/* 径向渐变光斑背景（首页 Hero / CTA 横幅） */
.bg-light-spots {
  background-image:
    radial-gradient(circle at 18% 22%, rgba(62, 198, 255, 0.16), transparent 40%),
    radial-gradient(circle at 82% 30%, rgba(123, 108, 255, 0.14), transparent 42%),
    radial-gradient(circle at 55% 88%, rgba(62, 198, 255, 0.1), transparent 46%);
  background-color: var(--bg-base);
}

/* 深底细描边卡片 */
.card-surface {
  background-color: var(--bg-surface);
  border: 1rpx solid var(--border-line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* 发光描边线条 */
.border-glow-line {
  border: 1rpx solid rgba(62, 198, 255, 0.5);
  box-shadow: inset 0 0 12rpx rgba(62, 198, 255, 0.2);
}

/* 带光晕的区块标题 */
.section-title-glow {
  color: var(--text-primary);
  font-weight: 800;
  text-shadow: 0 0 22rpx rgba(62, 198, 255, 0.3);
}

/* 流程步骤序号（发光描边数字） */
.process-step-num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--accent-glow);
  text-shadow: 0 0 18rpx rgba(62, 198, 255, 0.35);
}

/* 主按钮流光扫过动画（仅用于主 CTA） */
.btn-sweep {
  position: relative;
  overflow: hidden;
}

.btn-sweep::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: linear-gradient(
    115deg,
    transparent 30%,
    rgba(255, 255, 255, 0.35) 50%,
    transparent 70%
  );
  background-size: 220% 100%;
  background-position: 120% 0;
  animation: sweep 4s ease-in-out infinite;
  pointer-events: none;
}

@keyframes sweep {
  0%, 55% { background-position: 120% 0; }
  80%, 100% { background-position: -80% 0; }
}

/* ==================================================================
   通用标签
   ================================================================== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.4;
  border-radius: var(--radius-tag);
  background-color: var(--bg-surface-2);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-line);
}

/* 安全区底部留白（全面屏适配） */
.safe-bottom {
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}