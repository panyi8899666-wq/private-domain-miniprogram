/* spec-picker 排版规范化（layout-polish T11）
   契约：C-TOKENS@1 / C-LAYOUT-CLASSES@1 (b) chip 基线 / C-CLICK-TARGET@1
   仅收敛间距/圆角/chip 基线与点击区；不影响主题配色 */
.spec-picker {
  padding: var(--gap-xs) 0;
}


.spec-label {
  font-size: 26rpx;
  margin-bottom: var(--gap-sm);
}


.spec-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap-sm);
}


/* 对齐 C-LAYOUT-CLASSES@1 (b) 统一 chip 基线 */
.spec-chip {
  padding: 12rpx 28rpx;
  border-radius: var(--radius-tag);
  border: 1rpx solid var(--border-line);
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.4;
  background: var(--bg-surface);
}


.spec-chip-active {
  color: var(--accent-glow);
  border-color: var(--accent-glow);
  background: rgba(198, 161, 91, 0.1);
}


.spec-qty {
  margin-top: var(--gap-md);
  align-items: center;
}


.spec-stepper {
  display: flex;
  align-items: center;
}


/* 步进按钮：64→72rpx 满足 C-CLICK-TARGET@1（≥72rpx）；± 字形字号按固有控制符保留 */
.spec-step {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  color: var(--text-primary);
  background: var(--bg-surface-2);
  border: 1rpx solid var(--border-line);
  font-size: 34rpx;
}


.spec-num {
  min-width: 88rpx;
  text-align: center;
  color: var(--text-primary);
  font-size: 28rpx;
}
