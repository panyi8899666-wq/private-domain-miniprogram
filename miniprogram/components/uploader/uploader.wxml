<view class="uploader">
  <view class="upload-grid">
    <view wx:for="{{list}}" wx:key="index" class="upload-item">
      <image class="upload-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="onPreview" />
      <view class="upload-del" data-index="{{index}}" catchtap="onRemove">×</view>
    </view>
    <view wx:if="{{list.length < maxCount}}" class="upload-add" bindtap="onChoose">
      <text class="upload-add-plus">＋</text>
      <text class="upload-add-text">添加图片</text>
    </view>
  </view>
  <text class="upload-tip text-muted">最多 {{maxCount}} 张，支持相册与拍照</text>
</view>