<view class="work-card card-surface" hover-class="work-card-hover" bindtap="onTap">
  <view class="work-cover-wrap">
    <!-- 仅有真实封面时才渲染图片；组件 js 的占位常量 PLACEHOLDER 路径不渲染，避免加载不存在的本地文件 -->
    <image
      wx:if="{{cover && cover !== '/images/placeholder.png'}}"
      class="work-cover"
      src="{{cover}}"
      mode="aspectFill"
      lazy-load
      binderror="onImageError"
    />
    <!-- 无封面或加载失败（binderror 触发后 cover 回退为 PLACEHOLDER）时的占位：R9.6 -->
    <!-- 背景色由 .work-cover-wrap 提供，叠加文本占位，不依赖 images/ 资源 -->
    <view wx:else class="cover-fallback">暂无图片</view>
  </view>
  <view class="work-body">
    <view class="work-head row-between">
      <text class="work-name ellipsis">{{work.name}}</text>
      <text wx:if="{{work.categoryName}}" class="work-cat tag">{{work.categoryName}}</text>
    </view>
    <text wx:if="{{work.note}}" class="work-note ellipsis-2">{{work.note}}</text>
  </view>
</view>