<view class="product-card card-surface" hover-class="product-card-hover" bindtap="onTap">
  <view class="product-cover-wrap">
    <!-- 仅有真实封面时才渲染图片；组件 js 的占位常量 PLACEHOLDER 路径不渲染，避免加载不存在的本地文件 -->
    <image
      wx:if="{{cover && cover !== '/images/placeholder.png'}}"
      class="product-cover"
      src="{{cover}}"
      mode="aspectFill"
      lazy-load
      binderror="onImageError"
    />
    <!-- 无封面或加载失败（binderror 触发后 cover 回退为 PLACEHOLDER）时的占位：R9.6 -->
    <!-- 背景色由 .product-cover-wrap 提供，叠加文本占位，不依赖 images/ 资源 -->
    <view
      wx:else
      class="product-cover-fallback"
      style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--text-secondary);font-size:24rpx;"
    >暂无图片</view>
  </view>
  <view class="product-body">
    <text class="product-name ellipsis">{{product.name}}</text>
    <view class="product-foot row-between">
      <text class="product-price text-price">¥{{product.priceFrom}} 起</text>
      <text wx:if="{{product.sales}}" class="product-sales text-muted">已售{{product.sales}}</text>
    </view>
  </view>
</view>