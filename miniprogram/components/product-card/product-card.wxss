/* ==================================================================
   product-card 组件排版（layout-polish T9）
   契约：C-TOKENS@1 / C-LAYOUT-CLASSES@1 / C-CLICK-TARGET@1 / C-INLINE-CONVERGE@1
   说明：卡片基线沿用全局 .card-surface（圆角 --radius-card / 描边 / 阴影）；
        封面占位文本收敛为全局 .cover-fallback（见 product-card.wxml）；
        内容区内边距统一 --gap-md；字号取 C-TOKENS 刻度层级。
   ================================================================== */
.product-card {
  border-radius: var(--radius-card);
  overflow: hidden;
}

.product-cover-wrap {
  width: 100%;
  height: 300rpx;            /* 封面固有高度（C-TOKENS 例外，不刻度化） */
  background: var(--bg-surface-2);
}

.product-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.product-body {
  padding: var(--gap-md);    /* 卡片内边距基线 24rpx（原 18/24/24，收敛到 --gap-md） */
}

.product-name {
  display: block;            /* 使全局 .ellipsis 在块级生效，保证单行省略（R3.AC1/R3.AC4） */
  font-size: 30rpx;          /* item-title 级（原 29rpx，映射到刻度） */
  font-weight: 600;
  color: var(--text-primary);
}

.product-foot {
  margin-top: var(--gap-xs); /* 8rpx（原 10rpx，映射到最近刻度，与 work-card 命名对齐） */
  align-items: center;
}

.product-sales {
  font-size: 22rpx;          /* tag 级（刻度内，保持不变） */
}