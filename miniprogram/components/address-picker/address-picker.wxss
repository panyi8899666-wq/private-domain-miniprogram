.address-picker {
  border-radius: var(--radius-btn);
  padding: 24rpx;
  border: 1rpx solid var(--border-line);
}

.addr-line1 {
  align-items: center;
  gap: 20rpx;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.addr-phone {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.addr-detail {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.addr-empty {
  min-height: 60rpx;
  display: flex;
  align-items: center;
}

.addr-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.addr-modal {
  width: 82%;
  background: var(--bg-surface);
  border-radius: var(--radius-card);
  padding: 40rpx 32rpx;
}

.addr-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: var(--text-primary);
}

.addr-input {
  height: 88rpx;
  border: 1rpx solid var(--border-line);
  border-radius: var(--radius-tag);
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  background: var(--bg-surface-2);
  color: var(--text-primary);
  font-size: 28rpx;
}

.addr-btns {
  margin-top: 12rpx;
}

.addr-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  font-size: 30rpx;
}

.addr-cancel {
  color: var(--text-secondary);
  background: var(--bg-surface-2);
  margin-right: 20rpx;
}

.addr-ok {
  color: #04121a;
  font-weight: 600;
}