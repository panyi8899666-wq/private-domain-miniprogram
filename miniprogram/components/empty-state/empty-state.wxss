/* 空态容器：上下留白统一到全局状态容器共识值
   （C-LAYOUT-CLASSES@1 (c) / D1 默认 80rpx 0，与各页 .empty-box 一致） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-surface);
  margin-bottom: var(--gap-lg);
}

.empty-icon-text {
  font-size: 56rpx;
  color: var(--accent-glow);
  line-height: 1;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: var(--gap-xs);
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.5;
}

/* 空态按钮：内边距刻度化（视觉等价 16rpx/48rpx），字号 body 级、
   圆角对齐按钮基线（R5.AC2），上下 --gap-sm + 行高 ≥72rpx 满足点击区下限 */
.empty-btn {
  margin-top: var(--gap-lg);
  padding: var(--gap-sm) var(--gap-xl);
  font-size: 28rpx;
  border-radius: var(--radius-btn);
}

.empty-btn-hover {
  opacity: 0.85;
}