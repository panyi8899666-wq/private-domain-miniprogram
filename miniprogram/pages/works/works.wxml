<view class="page-container">
  <!-- 搜索入口（R9.3 / C-NAV@1）：跳转搜索页，scope=works -->
  <view
    class="search-entry"
    bindtap="goSearch"
    style="display:flex;align-items:center;gap:12rpx;margin:8rpx 0 16rpx;padding:16rpx 24rpx;border-radius:var(--radius-btn);border:1rpx solid var(--border-line);background:var(--bg-surface);"
  >
    <text style="font-size:28rpx;">🔍</text>
    <text style="color:var(--text-secondary);font-size:26rpx;">搜索作品</text>
  </view>

  <scroll-view scroll-x class="cat-bar">
    <view class="cat-scroll">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat-chip {{item.id === activeCategory ? 'cat-chip-active box-glow' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectCategory"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <loading wx:if="{{loading}}" type="skeleton" />

  <!-- 错误态（R9.4）：可重试，复用 empty-state；与 .js 的 error 状态字段一致 -->
  <view wx:elif="{{error}}" class="empty-box">
    <empty-state
      text="{{error.message}}"
      buttonText="重试"
      showButton="{{error.retriable}}"
      bind:action="onRetry"
    />
  </view>

  <!-- 空态（R9.4）：与错误态区分 -->
  <view wx:elif="{{list.length === 0}}" class="empty-box">
    <empty-state text="暂无作品" subText="该分类下还没有案例" />
  </view>

  <view wx:else class="work-grid">
    <work-card wx:for="{{list}}" wx:key="code" work="{{item}}" bind:tap="onPreviewWork" />
  </view>

  <view wx:if="{{loadingMore}}" class="loading-more text-muted">加载中...</view>
  <view wx:if="{{!hasMore && list.length > 0}}" class="loading-more text-muted">— 已经到底啦 —</view>
</view>