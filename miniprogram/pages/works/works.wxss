.cat-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg-base);
  padding: 16rpx 0;
  white-space: nowrap;
}

.cat-scroll {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.cat-chip {
  padding: 10rpx 28rpx;
  border-radius: var(--radius-tag);
  border: 1rpx solid var(--border-line);
  color: var(--text-secondary);
  font-size: 26rpx;
  flex-shrink: 0;
}

.cat-chip-active {
  color: var(--accent-glow);
  border-color: var(--accent-glow);
  background: rgba(62, 198, 255, 0.1);
}

.work-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 16rpx;
}

.empty-box {
  padding: 80rpx 0;
}

.loading-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
}