<view class="page-container">
  <view class="shop-head">
    <text class="shop-title section-title-glow">标准品商城</text>
    <text class="shop-sub text-aux">固定价格直接下单，定制需求请走「定制」</text>
  </view>

  <!-- 搜索入口（R9.3 / C-NAV@1）：跳转搜索页，scope=shop -->
  <view class="search-entry" bindtap="goSearch">
    <text class="search-entry-icon">🔍</text>
    <text class="search-entry-text">搜索商品</text>
  </view>

  <loading wx:if="{{loading}}" type="skeleton" />

  <!-- 错误态（R9.4）：可重试，复用 empty-state；与 .js 的 error 状态字段一致 -->
  <view wx:elif="{{error}}" class="empty-box">
    <empty-state
      text="{{error.message}}"
      buttonText="重试"
      showButton="{{error.retriable}}"
      bind:action="onRetry"
    />
  </view>

  <!-- 空态（R9.4）：与错误态区分 -->
  <view wx:elif="{{list.length === 0}}" class="empty-box">
    <empty-state text="暂无商品" subText="商家正在上新，敬请期待" />
  </view>

  <view wx:else class="product-grid">
    <product-card wx:for="{{list}}" wx:key="code" product="{{item}}" bind:tap="onTapProduct" />
  </view>

  <view wx:if="{{loadingMore}}" class="loading-more text-muted">加载中...</view>
  <view wx:if="{{!hasMore && list.length > 0}}" class="loading-more text-muted">— 已经到底啦 —</view>
</view>