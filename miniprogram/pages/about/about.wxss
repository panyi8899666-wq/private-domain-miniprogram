/* 关于我们（layout-polish T8）
   排版刻度/字号层级/圆角/对齐/点击区收敛到 C-TOKENS@1 与 C-LAYOUT-CLASSES@1；
   深色香槟金主题配色不变，未改任何绑定/事件/文案。 */

.about-page {
  padding-top: var(--gap-lg);
}

/* 品牌区 */
.about-hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: var(--gap-lg);
  margin-bottom: var(--gap-xl);
}

.about-brand {
  font-size: 44rpx; /* display-2：品牌大标题 */
  font-weight: 800;
}

.about-slogan {
  margin-top: var(--gap-xs);
  font-size: 26rpx; /* body-sm */
}

.about-scope {
  margin-top: var(--gap-sm);
}

/* 通用区块 */
.about-section {
  margin-bottom: var(--gap-xl);
}

.about-intro {
  display: block;
  margin-top: var(--gap-sm);
  line-height: 1.6; /* 正文行高统一 ≥1.5 */
  word-break: break-word; /* 长串文本换行不溢出 */
}

/* 业务范围 */
.service-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
  margin-top: var(--gap-sm);
}

.service-item {
  display: flex;
  flex-direction: column;
  padding: var(--gap-md); /* 卡片内边距基线 */
}

.service-name {
  font-size: 30rpx; /* item-title */
  font-weight: 600;
  color: var(--text-primary);
}

.service-desc {
  margin-top: var(--gap-xs);
  font-size: 24rpx; /* aux */
}

/* 联系方式 */
.contact-card {
  padding: var(--gap-md); /* 卡片内边距基线 */
  margin-top: var(--gap-sm);
}

/* 联系信息行：可点击行（拨打电话）点击区目标 88rpx（C-CLICK-TARGET@1） */
.contact-row {
  min-height: 88rpx;
  padding: var(--gap-xs) 0;
}

.contact-label {
  font-size: 26rpx; /* body-sm */
  flex-shrink: 0;
}

.contact-value {
  font-size: 28rpx; /* body */
  word-break: break-word; /* 长号码/长串换行不溢出 */
}

.contact-actions {
  display: flex;
  gap: var(--gap-sm);
  margin-top: var(--gap-md);
}

/* 按钮基线：圆角 --radius-btn、字号 28rpx，内边距收敛使高度达标（≈88rpx） */
.about-btn {
  flex: 1;
  text-align: center;
  padding: var(--gap-md);
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  font-weight: 600;
}

/* 覆盖 button 默认样式，使客服按钮与 view 按钮观感一致 */
button.contact-btn {
  margin: 0;
  line-height: 1.4;
  background-color: rgba(198, 161, 91, 0.08);
}

.contact-note {
  display: block;
  margin-top: var(--gap-md);
  font-size: 22rpx; /* tag */
  line-height: 1.5;
}

/* 行动入口 */
.about-cta {
  display: flex;
  gap: var(--gap-sm);
  margin-bottom: var(--gap-xl);
}