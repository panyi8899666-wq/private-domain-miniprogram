.about-page {
  padding-top: var(--gap-lg);
}

/* 品牌区 */
.about-hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: var(--gap-lg);
  margin-bottom: var(--gap-xl);
}

.about-brand {
  font-size: 44rpx;
  font-weight: 800;
}

.about-slogan {
  margin-top: 10rpx;
  font-size: 26rpx;
}

.about-scope {
  margin-top: 16rpx;
}

/* 通用区块 */
.about-section {
  margin-bottom: var(--gap-xl);
}

.about-intro {
  display: block;
  margin-top: var(--gap-sm);
  line-height: 1.7;
}

/* 业务范围 */
.service-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: var(--gap-sm);
}

.service-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx 24rpx;
}

.service-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.service-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
}

/* 联系方式 */
.contact-card {
  padding: var(--gap-md);
  margin-top: var(--gap-sm);
}

.contact-row {
  padding: 12rpx 0;
}

.contact-label {
  font-size: 26rpx;
  flex-shrink: 0;
}

.contact-value {
  font-size: 28rpx;
}

.contact-actions {
  display: flex;
  gap: 20rpx;
  margin-top: var(--gap-md);
}

.about-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx;
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  font-weight: 600;
}

/* 覆盖 button 默认样式，使客服按钮与 view 按钮观感一致 */
button.contact-btn {
  margin: 0;
  line-height: 1.4;
  background-color: rgba(198, 161, 91, 0.08);
}

.contact-note {
  display: block;
  margin-top: var(--gap-md);
  font-size: 22rpx;
  line-height: 1.5;
}

/* 行动入口 */
.about-cta {
  display: flex;
  gap: 20rpx;
  margin-bottom: var(--gap-xl);
}