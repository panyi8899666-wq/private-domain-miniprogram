.search-page {
  padding-top: var(--gap-lg);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 var(--gap-md);
  border-radius: var(--radius-btn);
  background-color: var(--bg-surface);
  border: 1rpx solid var(--border-line);
  color: var(--text-primary);
  font-size: 28rpx;
}

/* 清空操作（图标操作）：保证最小点击高度（C-CLICK-TARGET@1） */
.search-clear {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 var(--gap-xs);
  font-size: 24rpx;
}

.search-btn {
  flex-shrink: 0;
  padding: var(--gap-sm) var(--gap-lg);
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  font-weight: 600;
}

/* scope 切换 */
.scope-bar {
  display: flex;
  gap: var(--gap-sm);
  margin: var(--gap-md) 0 var(--gap-lg);
}

/* scope chip：对齐 C-LAYOUT-CLASSES@1 (b) 统一选中 chip 基线 */
.scope-chip {
  padding: 12rpx 28rpx;
  border-radius: var(--radius-tag);
  border: 1rpx solid var(--border-line);
  color: var(--text-secondary);
  background-color: var(--bg-surface);
  font-size: 26rpx;
  line-height: 1.4;
}

.scope-chip-active {
  color: var(--accent-glow);
  border-color: var(--accent-glow);
  background: rgba(198, 161, 91, 0.1);
}

/* 状态占位（引导 / 错误 / 空结果）：上下留白统一到 D1 默认 80rpx 0
   （C-LAYOUT-CLASSES@1 (c)，与 .empty-box 同一共识值） */
.state-box {
  padding: 80rpx 0;
}

.result-count {
  margin-bottom: var(--gap-sm);
  font-size: 24rpx;
}

/* 结果网格：gap 刻度化（与首页 / 作品 / 商城 grid 一致） */
.work-grid,
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--gap-md);
}

/* 材质结果列表（纵向） */
.material-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

.material-item {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: var(--gap-md);
}

/* 主名称：单行省略（R3.AC1），可收缩宽度避免窄屏溢出 */
.material-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 副标题：单行省略 */
.material-title {
  margin-top: var(--gap-xs);
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 描述：两行省略（R3.AC2，wxml 已配 .ellipsis-2 提供 clamp） */
.material-intro {
  margin-top: var(--gap-xs);
  font-size: 24rpx;
  line-height: 1.5;
}