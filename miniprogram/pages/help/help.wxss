/* 帮助与售后（layout-polish T8）
   排版刻度/字号层级/圆角/对齐/点击区收敛到 C-TOKENS@1 与 C-LAYOUT-CLASSES@1；
   深色香槟金主题配色不变，未改任何绑定/事件/文案。 */

.help-page {
  padding-top: var(--gap-lg);
}

.help-hero {
  margin-bottom: var(--gap-xl);
}

.help-sub {
  display: block;
  margin-top: var(--gap-xs);
  font-size: 24rpx; /* aux */
}

.help-section {
  margin-bottom: var(--gap-xl);
}

/* 下单流程 */
.step-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
  margin-top: var(--gap-sm);
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: var(--gap-sm);
  padding: var(--gap-md); /* 卡片内边距基线 */
}

.step-num {
  flex-shrink: 0;
}

.step-body {
  flex: 1;
  min-width: 0; /* 允许子文本收缩，配合省略/换行 */
  display: flex;
  flex-direction: column;
}

.step-title {
  font-size: 30rpx; /* item-title */
  font-weight: 600;
  color: var(--text-primary);
}

.step-desc {
  margin-top: var(--gap-xs);
  font-size: 24rpx; /* aux */
  line-height: 1.5;
  word-break: break-word; /* 长串文本换行不溢出 */
}

/* 说明卡片 */
.tip-card {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
  padding: var(--gap-md); /* 卡片内边距基线 */
  margin-top: var(--gap-sm);
}

.tip-item {
  display: block;
  line-height: 1.6; /* 正文行高 ≥1.5 */
  word-break: break-word; /* 长串文本换行不溢出 */
}

/* 常见问题 */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
  margin-top: var(--gap-sm);
}

/* FAQ 整行可点击：内边距基线 + 头部行高保证点击区达标（C-CLICK-TARGET@1） */
.faq-item {
  padding: var(--gap-md);
}

.faq-head {
  gap: var(--gap-sm);
}

.faq-q {
  flex: 1;
  min-width: 0;
  font-size: 28rpx; /* body */
  font-weight: 600;
  color: var(--text-primary);
  word-break: break-word; /* 长问题换行不溢出 */
}

.faq-toggle {
  flex-shrink: 0;
  font-size: 24rpx; /* aux */
}

/* FAQ 展开区（wx:if 控制）：与问题区对齐、间距刻度化、行高统一 */
.faq-a {
  display: block;
  margin-top: var(--gap-sm);
  font-size: 24rpx; /* aux */
  line-height: 1.6;
  word-break: break-word; /* 长答案换行不溢出 */
}

/* 售后与联系 */
.help-actions,
.help-cta {
  display: flex;
  gap: var(--gap-sm);
  margin-top: var(--gap-md);
}

.help-cta {
  margin-bottom: var(--gap-xl);
}

/* 按钮基线：圆角 --radius-btn、字号 28rpx，内边距收敛使高度达标（≈88rpx） */
.help-btn {
  flex: 1;
  text-align: center;
  padding: var(--gap-md);
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  font-weight: 600;
}

/* 覆盖 button 默认样式，使客服按钮与 view 按钮观感一致 */
button.contact-btn {
  margin: 0;
  line-height: 1.4;
  background-color: rgba(198, 161, 91, 0.08);
}

.help-note {
  display: block;
  margin-top: var(--gap-sm);
  font-size: 22rpx; /* tag */
}