.custom-page {
  padding-bottom: 60rpx;
}

.config-flow {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.step-block {
  padding: 8rpx 0;
}

.step-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  font-weight: 600;
}

/* 大类横滑 */
.chip-scroll {
  white-space: nowrap;
}
.chip-row {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

/* 通用 chip */
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 12rpx 26rpx;
  border-radius: var(--radius-tag);
  border: 1rpx solid var(--border-line);
  color: var(--text-secondary);
  font-size: 26rpx;
  background: var(--bg-surface);
  flex-shrink: 0;
}
.chip-active {
  color: var(--accent-glow);
  border-color: var(--accent-glow);
  background: rgba(62, 198, 255, 0.1);
}

/* 材质列表 */
.material-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.material-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border-line);
  border-radius: var(--radius-btn);
  background: var(--bg-surface);
}
.material-img {
  width: 176rpx;
  height: 132rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: var(--bg-base);
  border: 1rpx solid var(--border-line);
}
.material-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.material-active {
  border-color: var(--accent-glow);
  background: rgba(62, 198, 255, 0.08);
}
.material-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.material-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
}
.material-price {
  font-size: 24rpx;
  flex-shrink: 0;
}
.material-note {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

/* 配置面板 */
.config-panel {
  padding: 28rpx 24rpx;
}
.config-hero {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  background: var(--bg-base);
  border: 1rpx solid var(--border-line);
}
.config-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.config-section {
  margin-top: 24rpx;
}

/* 输入区 */
.input-row {
  display: flex;
  gap: 20rpx;
}
.input-group {
  flex: 1;
}
.input-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}
.input-box {
  height: 84rpx;
  border: 1rpx solid var(--border-line);
  border-radius: var(--radius-tag);
  padding: 0 24rpx;
  background: var(--bg-surface-2);
  color: var(--text-primary);
  font-size: 28rpx;
}
.input-box.full {
  margin-top: 16rpx;
  width: 100%;
}

/* 联系方式 */
.phone-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: flex-start;
}
.phone-btn {
  width: 100%;
  text-align: center;
  padding: 22rpx;
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  color: #04121a;
  font-weight: 600;
}
.phone-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.link {
  font-size: 26rpx;
  color: var(--accent-glow);
  text-decoration: underline;
}

/* 提交 */
.submit-bar {
  margin-top: 24rpx;
}
.submit-btn {
  width: 100%;
  text-align: center;
  padding: 26rpx;
  border-radius: var(--radius-btn);
  font-size: 32rpx;
  color: #04121a;
  font-weight: 600;
}