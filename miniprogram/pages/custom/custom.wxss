.custom-page {
  /* 非 tabBar、无固定底栏页：内容流底部留白 ≥ var(--gap-xl)（C-SAFE-AREA@1 (2)） */
  padding-bottom: var(--gap-xl);
}

/* 配置流程：各 step-block 之间间距刻度化 */
.config-flow {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

.step-block {
  padding: var(--gap-xs) 0;
}

.step-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: var(--gap-sm);
  font-weight: 600;
}

/* 大类横滑 */
.chip-scroll {
  white-space: nowrap;
}
.chip-row {
  display: inline-flex;
  gap: var(--gap-sm);
  /* 保留 4rpx：为容纳选中态发光阴影、避免被父级裁剪（视觉微调例外） */
  padding-bottom: 4rpx;
}

/* 通用 chip：对齐 C-LAYOUT-CLASSES@1 (b) 统一选中 chip 基线 */
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap-sm);
}
.chip {
  padding: 12rpx 28rpx;
  border-radius: var(--radius-tag);
  border: 1rpx solid var(--border-line);
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.4;
  background-color: var(--bg-surface);
  flex-shrink: 0;
}
.chip-active {
  color: var(--accent-glow);
  border-color: var(--accent-glow);
  background-color: rgba(198, 161, 91, 0.1);
}

/* 材质列表 */
.material-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}
.material-item {
  display: flex;
  gap: var(--gap-md);
  padding: var(--gap-md);
  border: 1rpx solid var(--border-line);
  border-radius: var(--radius-btn);
  background-color: var(--bg-surface);
}
.material-img {
  /* 图片固有尺寸，保留 */
  width: 176rpx;
  height: 132rpx;
  border-radius: var(--radius-tag);
  flex-shrink: 0;
  background-color: var(--bg-base);
  border: 1rpx solid var(--border-line);
}
.material-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.material-active {
  border-color: var(--accent-glow);
  background-color: rgba(198, 161, 91, 0.08);
}
.material-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--gap-sm);
}
/* 材质名称：单行省略（R3.AC1），可收缩宽度避免窄屏溢出（R3.AC4） */
.material-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.material-price {
  font-size: 24rpx;
  flex-shrink: 0;
}
/* 材质说明：两行省略（R3.AC2） */
.material-note {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: var(--gap-xs);
  font-size: 22rpx;
  line-height: 1.5;
}

/* 配置面板：卡片内边距基线 C-LAYOUT-CLASSES@1 (R5) */
.config-panel {
  padding: var(--gap-md);
}
.config-hero {
  /* 图片固有尺寸，保留 */
  width: 100%;
  height: 300rpx;
  border-radius: var(--radius-tag);
  margin-bottom: var(--gap-md);
  background-color: var(--bg-base);
  border: 1rpx solid var(--border-line);
}
/* 配置标题：单行省略（R3.AC1） */
.config-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: var(--gap-md);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.config-section {
  margin-top: var(--gap-md);
}

/* 输入区 */
.input-row {
  display: flex;
  gap: var(--gap-md);
}
.input-group {
  flex: 1;
}
.input-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: var(--gap-xs);
}
.input-box {
  /* 输入框固有高度，保留 */
  height: 84rpx;
  border: 1rpx solid var(--border-line);
  border-radius: var(--radius-tag);
  padding: 0 var(--gap-md);
  background-color: var(--bg-surface-2);
  color: var(--text-primary);
  font-size: 28rpx;
}
.input-box.full {
  margin-top: var(--gap-sm);
  width: 100%;
}

/* 联系方式 */
.phone-actions {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
  align-items: flex-start;
}
/* 授权按钮：对齐全局按钮基线（glow-button：min-height 84rpx / 圆角 --radius-btn / 字号 30rpx） */
.phone-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: var(--gap-sm) var(--gap-lg);
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  line-height: 1.2;
  color: #04121a;
  font-weight: 600;
}
.phone-info {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}
/* 文字链：保证最小点击高度 ≥ 72rpx（C-CLICK-TARGET@1） */
.link {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 var(--gap-xs);
  font-size: 26rpx;
  color: var(--accent-glow);
  text-decoration: underline;
}

/* 提交 */
.submit-bar {
  margin-top: var(--gap-md);
}
/* 主提交按钮：对齐全局按钮基线（glow-button.is-large：min-height 96rpx / 字号 32rpx） */
.submit-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: var(--gap-sm) var(--gap-lg);
  border-radius: var(--radius-btn);
  font-size: 32rpx;
  line-height: 1.2;
  color: #04121a;
  font-weight: 600;
}