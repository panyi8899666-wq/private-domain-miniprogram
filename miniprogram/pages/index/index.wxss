/* ==================================================================
   首页（layout-polish T2：浏览类页 A 排版规范化）
   间距/字号/圆角收敛到 C-TOKENS@1；对齐与溢出遵循 C-LAYOUT-CLASSES@1；
   不改动配色主题与结构，仅收敛刻度。
   注：高度 88rpx（按钮）、320rpx（max-width）、48rpx（服务图标）为
   元素固有尺寸，按 C-TOKENS@1 (a) 例外条款不刻度化。
   ================================================================== */

.hero {
  padding: var(--gap-xl) var(--gap-lg);
  text-align: center;
}

.hero-badge {
  display: inline-block;
  margin-bottom: var(--gap-sm);
}

.hero-brand {
  display: block;
  font-size: 40rpx;      /* display-1 */
  font-weight: 700;
  line-height: 1.4;
}

.hero-title {
  display: block;
  margin-top: var(--gap-sm);
  font-size: 44rpx;      /* display-2 */
  font-weight: 700;
  line-height: 1.3;
}

.hero-sub {
  display: block;
  margin-top: var(--gap-sm);
  font-size: 26rpx;      /* body-sm */
  color: var(--text-secondary);
}

.hero-btns {
  margin-top: var(--gap-lg);
  display: flex;
  gap: var(--gap-md);
  justify-content: center;
}

.hero-btn {
  flex: 1;
  max-width: 320rpx;     /* 固有尺寸，不刻度化 */
  height: 88rpx;         /* 按钮固定高度，不刻度化 */
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  font-size: 30rpx;      /* item-title */
  font-weight: 600;
}

.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--gap-md);
}

.service-card {
  padding: var(--gap-md);
  border-radius: var(--radius-card);
}

.service-icon {
  font-size: 48rpx;      /* 图标固有尺寸，不刻度化 */
  line-height: 1;
}

.service-name {
  display: block;
  margin-top: var(--gap-sm);
  font-size: 30rpx;      /* item-title */
  font-weight: 600;
  line-height: 1.4;
}

.service-desc {
  display: block;
  margin-top: var(--gap-xs);
  font-size: 24rpx;      /* aux */
  color: var(--text-secondary);
}

.more-link {
  font-size: 26rpx;      /* body-sm */
  color: var(--accent-glow);
}

.work-grid {
  margin-top: var(--gap-md);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--gap-md);
}

.process-list {
  margin-top: var(--gap-xs);
}

.process-item {
  display: flex;
  gap: var(--gap-md);
  padding: var(--gap-sm) 0;
}

.process-num {
  flex-shrink: 0;
}

.process-content {
  flex: 1;
  min-width: 0;
}

.process-title {
  display: block;
  font-size: 30rpx;      /* item-title */
  font-weight: 600;
  line-height: 1.4;
}

.process-desc {
  display: block;
  margin-top: var(--gap-xs);
  font-size: 24rpx;      /* aux */
  color: var(--text-secondary);
}

.process-cta {
  margin-top: var(--gap-md);
  height: 88rpx;         /* 按钮固定高度，不刻度化 */
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  font-size: 30rpx;      /* item-title */
  font-weight: 600;
}