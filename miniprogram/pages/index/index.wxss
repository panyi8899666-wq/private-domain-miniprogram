.hero {
  padding: 64rpx 32rpx 48rpx;
  text-align: center;
}

.hero-badge {
  display: inline-block;
  margin-bottom: 16rpx;
}

.hero-brand {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.hero-btns {
  margin-top: 40rpx;
  display: flex;
  gap: 24rpx;
  justify-content: center;
}

.hero-btn {
  flex: 1;
  max-width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  font-weight: 600;
}

.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.service-card {
  padding: 32rpx 28rpx;
  border-radius: var(--radius-card);
}

.service-icon {
  font-size: 48rpx;
  line-height: 1;
}

.service-name {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.service-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.more-link {
  font-size: 26rpx;
  color: var(--accent-glow);
}

.work-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.process-list {
  margin-top: 8rpx;
}

.process-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 0;
}

.process-num {
  flex-shrink: 0;
}

.process-content {
  flex: 1;
  min-width: 0;
}

.process-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.process-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.process-cta {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  font-weight: 600;
}