<view class="page-container">
  <loading wx:if="{{loading}}" />

  <view wx:elif="{{error}}" class="error-wrap">
    <empty-state
      text="{{error.message}}"
      buttonText="重试"
      showButton="{{error.retriable}}"
      bind:action="onRetry"
    />
  </view>

  <block wx:else>
    <!-- Hero 首屏 -->
    <view class="hero bg-light-spots">
      <text wx:if="{{slogan}}" class="hero-badge text-tag">{{slogan}}</text>
      <text class="hero-brand text-neon">{{siteName}}</text>
      <text class="hero-title text-glow-gradient">{{heroTitle}}</text>
      <text wx:if="{{heroSubtitle}}" class="hero-sub">{{heroSubtitle}}</text>
      <view class="hero-btns">
        <view class="hero-btn btn-primary-glow" bindtap="goCustom">立即提交需求</view>
        <view class="hero-btn btn-secondary-glow" bindtap="goShop">逛逛标准品</view>
      </view>
    </view>

    <!-- 核心服务 -->
    <view class="section">
      <text class="section-title section-title-glow">核心服务</text>
      <view class="service-grid">
        <view wx:for="{{services}}" wx:key="name" class="service-card card-surface" bindtap="goMaterial">
          <text class="service-icon">{{item.icon}}</text>
          <text class="service-name">{{item.name}}</text>
          <text class="service-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 作品案例 · 横向画廊 -->
    <view wx:if="{{featuredWorks.length}}" class="section case-section">
      <view class="row-between case-head">
        <view class="case-head-left">
          <text class="section-title section-title-glow">作品案例</text>
          <text class="case-sub">3D设计 · 展台美陈 · 户外标识 · 实拍 · 发光字</text>
        </view>
        <text class="more-link" bindtap="goWorks">全部案例 ›</text>
      </view>

      <scroll-view class="case-scroll" scroll-x enhanced enable-flex show-scrollbar="{{false}}" scroll-with-animation>
        <view class="case-track">
          <view
            wx:for="{{featuredWorks}}"
            wx:key="code"
            class="case-item"
            hover-class="case-item-hover"
            bindtap="onTapCase"
            data-index="{{index}}"
          >
            <image
              wx:if="{{item.images[0]}}"
              class="case-cover"
              src="{{item.images[0]}}"
              mode="aspectFill"
              lazy-load
              binderror="onCaseImageError"
              data-index="{{index}}"
            />
            <view wx:else class="cover-fallback">暂无图片</view>
            <view class="case-shade"></view>
            <text wx:if="{{item.categoryName}}" class="case-badge">{{item.categoryName}}</text>
            <text class="case-num">{{item.seq}}</text>
            <view class="case-meta">
              <text class="case-name ellipsis">{{item.name}}</text>
              <text wx:if="{{item.note}}" class="case-note ellipsis-2">{{item.note}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 接单流程 -->
    <view class="section">
      <text class="section-title section-title-glow">接单流程</text>
      <view class="process-list">
        <view wx:for="{{process}}" wx:key="step" class="process-item">
          <view class="process-num process-step-num">{{item.step}}</view>
          <view class="process-content">
            <text class="process-title">{{item.title}}</text>
            <text class="process-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
      <view class="process-cta btn-primary-glow" bindtap="goCustom">立即提交需求</view>
    </view>
  </block>
</view>